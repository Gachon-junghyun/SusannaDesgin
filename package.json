    "supabase:rls": "node scripts/check-rls.mjs",
    "notify:test": "node scripts/check-notify.mjs",
    "quotes:check": "node scripts/check-quote-files.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "cf:build": "node scripts/gen-image-manifest.mjs && opennextjs-cloudflare build",
