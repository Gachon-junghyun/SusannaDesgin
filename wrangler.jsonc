/**
 * Cloudflare Workers 배포 설정.
 *
 * 대부분 Cloudflare 대시보드에서 자동으로 처리되므로 손댈 일이 거의 없습니다.
 * 환경변수(Supabase 키)는 이 파일이 아니라 대시보드에서 넣습니다 —
 * 여기 적으면 GitHub 에 그대로 올라갑니다.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "susanna-design",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  // Next.js 는 Node.js API 를 씁니다. 이 플래그가 없으면 빌드가 통과해도 실행이 깨집니다.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
