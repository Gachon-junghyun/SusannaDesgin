# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 예시 파일은 실제 키가 없으므로 함께 관리합니다
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 견적문의 접수 기록
/data


# 개인 사진·임시 파일
KakaoTalk_*.jpg

# 네이버 플레이스 업로드용 사진 사본 (public/images 에서 파일명만 바꿔 복사한 것)
/_place-upload

# Cloudflare 배포 산출물
.open-next/
.wrangler/

# 형제 저장소(DeGaJa_Agent) 연결 — 이 PC 의 절대경로가 들어가고 저장소는 공개입니다
.mcp.json
