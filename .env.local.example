# -------------------------------------------------------------------
# Supabase — 관리자 기능(사진·실적 직접 수정)에 필요합니다.
#
# 이 파일을 복사해 `.env.local` 로 만들고 값을 채운 뒤 서버를 다시 시작하세요.
#   Supabase 대시보드 → Project Settings → API 에서 그대로 복사하면 됩니다.
#
# 값이 비어 있으면 관리자 기능만 꺼지고, 공개 홈페이지는 지금처럼 정상 동작합니다.
# -------------------------------------------------------------------

# 프로젝트 주소 (예: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon public 키.
# 브라우저에 노출되는 게 정상인 키입니다. 실제 권한은 DB 의 RLS 정책이 판단합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -------------------------------------------------------------------
# (선택) 명령줄로 콘텐츠를 관리할 때만 필요합니다.  →  npm run cms -- help
#
# 관리자 화면에 로그인하는 그 계정입니다. 브라우저를 열지 않고
# 슬라이드·실적을 추가·수정·삭제하고 사진을 올릴 수 있습니다.
#
# 비워 두면 `npm run cms` 만 안 되고, 관리자 화면과 홈페이지는 그대로 동작합니다.
#
# ⚠️ 비밀번호가 이 파일에 그대로 적힙니다. git 에는 올라가지 않지만,
#    이 PC 를 쓰는 사람은 볼 수 있습니다. 화면칠 때 가리세요.
# ⚠️ 이 값은 서버 코드에서 읽지 않습니다(NEXT_PUBLIC_ 접두어 없음 = 브라우저에
#    절대 나가지 않음). 오직 위 스크립트만 씁니다.
# -------------------------------------------------------------------
# SUPABASE_ADMIN_EMAIL=
# SUPABASE_ADMIN_PASSWORD=

# -------------------------------------------------------------------
# (선택) 지금 이 사이트가 서비스되는 주소.
#
# 비워 두면 config/site.ts 의 확정 도메인(https://susannadesign.co.kr)을 씁니다.
# 운영 배포에서는 비워 두는 것이 맞습니다.
#
# 임시 주소(*.workers.dev)나 미리보기로 배포할 때만 그 주소를 넣으세요.
# 그러면 robots.txt 가 검색엔진 전면 차단으로 바뀝니다 —
# 임시 주소가 검색에 잡혀 진짜 도메인과 순위를 깎아먹는 걸 막습니다.
# -------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=

# -------------------------------------------------------------------
# (선택) 견적 문의 실시간 알림.
#
# 안 넣으면 알림만 꺼지고 접수·저장은 그대로 됩니다(/admin/quotes 에서 확인).
# 둘 다 넣으면 양쪽으로 다 보냅니다.
#
# ⚠️ 알림에는 고객 이름·연락처가 담깁니다. 외부 서비스로 보내는 건
#    개인정보 처리 위탁에 해당하므로, 켜시면 개인정보처리방침의 위탁 항목에
#    그 업체(슬랙·Resend 등)를 적어야 합니다. (개인정보보호법 제26조)
# -------------------------------------------------------------------

# 방법 A — 웹훅 (가장 쉬움). 슬랙·카카오워크·디스코드 주소를 그대로 넣으면 됩니다.
# QUOTE_WEBHOOK_URL=

# 방법 B — 이메일 (resend.com 무료 플랜: 하루 100통)
#
# ⚠️ SMTP(네이버웍스·Gmail 계정 직접 연결)는 쓸 수 없습니다.
#    Cloudflare Workers 가 TCP 소켓을 못 열어서, HTTP API 방식만 됩니다.
#
# RESEND_API_KEY 만 넣으면 config/site.ts 의 회사 대표 메일로 갑니다.
# RESEND_API_KEY=
#
# 다른 주소로 받고 싶을 때만. 쉼표로 여러 개 가능.
# QUOTE_NOTIFY_EMAIL=받을주소@example.com
#
# 보내는 주소.
# ⚠️ Resend 는 도메인 등록 전까지 **가입 계정 본인 메일로만** 보낼 수 있습니다.
#    회사 메일로 받으려면 resend.com/domains 에 susannadesign.co.kr 을 등록하고
#    아래 값을 넣어야 합니다. (등록 전에 이 값을 먼저 넣으면 403 이 납니다)
# QUOTE_MAIL_FROM=noreply@susannadesign.co.kr

# 넣은 뒤 확인:  npm run notify:test   (가짜 문의를 만들지 않고 알림만 시험 발송)

# service_role 키는 이 프로젝트에서 쓰지 않습니다.
# 그 키는 RLS 를 통째로 무시하므로, 실수로 브라우저에 노출되면
# 누구나 데이터를 지울 수 있습니다. 여기에 적지 마세요.
