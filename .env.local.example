# -------------------------------------------------------------------
# Supabase — 관리자 기능(사진·실적 직접 수정)에 필요합니다.
#
# 이 파일을 복사해 `.env.local` 로 만들고 값을 채운 뒤 서버를 다시 시작하세요.
#   Supabase 대시보드 → Project Settings → API 에서 그대로 복사하면 됩니다.
#
# 값이 비어 있으면 관리자 기능만 꺼지고, 공개 홈페이지는 지금처럼 정상 동작합니다.
# -------------------------------------------------------------------

# 프로젝트 주소 (예: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon public 키.
# 브라우저에 노출되는 게 정상인 키입니다. 실제 권한은 DB 의 RLS 정책이 판단합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키는 이 프로젝트에서 쓰지 않습니다.
# 그 키는 RLS 를 통째로 무시하므로, 실수로 브라우저에 노출되면
# 누구나 데이터를 지울 수 있습니다. 여기에 적지 마세요.
